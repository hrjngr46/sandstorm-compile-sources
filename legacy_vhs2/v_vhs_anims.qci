	"b_root" 0
	"b_wpn" 0
	"b_wpn_bolt" 1
}

$definemacro macro_idlesequence \\
"anims\AN_1P_VHS_B_Idle.smd" frames 1 1

$sequence "idle_macro" {
	$macro_idlesequence
	hidden
}

//Trigger stuff

$sequence "delta_trigger" delta {
	"anims\AN_1P_VHS_B_FireTrigger.smd"
	frames 0 10
	hidden
	weightlist "weights_trigger"
}

$definemacro macro_fire_trigger \\
blendlayer "delta_trigger" 0 1 10 10

//Boltback

$sequence "delta_fire_bolt" delta {
	"anims\AN_1P_VHS_B_FireBolt.smd"
	frames 0 10
	hidden
	weightlist "weights_bolt"
}

$sequence "delta_fire_boltback" delta {
	"anims\AN_1P_VHS_B_FireBolt.smd"
	frames 1 1
	hidden
	loop
	fixuploop -1 1
	weightlist "weights_bolt"
}

$definemacro macro_fire_bolt \\
blendlayer "delta_fire_bolt" 0 1 10 10

$definemacro macro_fire_boltback \\
addlayer "delta_fire_boltback"

//IK fire layers

$animation a_ik_fire_1 "anims\AN_1P_VHS_B_Fire01.smd"
$sequence "delta_ik_fire_1" delta a_ik_fire_1 weightlist "weights_fire" hidden

$animation a_ik_fire_2 "anims\AN_1P_VHS_B_Fire02.smd"
$sequence "delta_ik_fire_2" delta a_ik_fire_2 weightlist "weights_fire" hidden

$animation a_ik_fire_3 "anims\AN_1P_VHS_B_Fire03.smd"
$sequence "delta_ik_fire_3" delta a_ik_fire_3 weightlist "weights_fire" hidden

$animation a_ik_dryfire "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_Dryfire.smd"
$sequence "delta_ik_dryfire" delta a_ik_dryfire weightlist "weights_wpnonly" hidden

$animation a_ik_i_fire_1 "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_IRON_Fire.smd"
$sequence "delta_ik_i_fire_1" delta a_ik_i_fire_1 weightlist "weights_wpnonly" hidden

$animation a_ik_i_fire_2 "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_IRON_Fire2.smd"
$sequence "delta_ik_i_fire_2" delta a_ik_i_fire_2 weightlist "weights_wpnonly" hidden

$animation a_ik_i_fire_3 "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_IRON_Fire3.smd"
$sequence "delta_ik_i_fire_3" delta a_ik_i_fire_3 weightlist "weights_wpnonly" hidden

$animation a_ik_i_dryfire "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_IRON_Dryfire.smd"
$sequence "delta_ik_i_dryfire" delta a_ik_i_dryfire weightlist "weights_wpnonly" hidden

//Draw/Holster layers

$animation a_ik_draw "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_Draw.smd"
$sequence "delta_ik_draw" delta a_ik_draw weightlist "weights_wpnonly" hidden

$animation a_ik_holster "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_Holster.smd"
$sequence "delta_ik_holster" delta a_ik_holster weightlist "weights_wpnonly" hidden

//Sprint layers

$animation a_ik_sprint "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_Sprint_Alt.smd" subtract "idle_macro" 0
$sequence "delta_ik_sprint" delta a_ik_sprint weightlist "weights_sprint" loop fixuploop -1 1 hidden

$animation a_ik_sprint_hardcore "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_Sprint_Hardcore_Alt.smd" subtract "idle_macro" 0
$sequence "delta_ik_sprint_hardcore" delta a_ik_sprint_hardcore weightlist "weights_sprint_onehand" loop fixuploop -1 1 hidden

//Inspect

$animation a_ik_inspect "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_Idle_Inspect.smd" 
$sequence "delta_ik_inspect" delta a_ik_inspect weightlist "weights_inspect" hidden

//Bash

$animation a_ik_bash "F:\tools\sandstorm_source_files\release\animations\gen_rif\anims\AN_1P_GEN_RIF_B_Melee_Muzzle.smd" 
$sequence "delta_ik_bash" delta a_ik_bash weightlist "weights_wpnonly" hidden

$sequence "idle" {
	$macro_idlesequence
	activity "ACT_VM_IDLE" 1
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	loop
	fps 30
}

$sequence "idle_empty" {
	$macro_idlesequence
	activity "ACT_VM_IDLE_EMPTY" 1
	$macro_fire_boltback
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	loop
	fps 30
}

$sequence "ready" {
	anims/AN_1P_VHS_B_Ready.smd
	{ event 5004 43 "WPN_1P_VHS.vhs2_foley_arm_movement" }
	{ event 5004 55 "WPN_1P_VHS.vhs2_foley_mag_in" }
	{ event 5004 76 "WPN_1P_VHS.vhs2_foley_mag_hit" }
	{ event 5004 108 "WPN_1P_VHS.vhs2_foley_charging_handle_pull" }
	{ event 5004 119 "WPN_1P_VHS.vhs2_foley_charging_handle_release" }
	activity "ACT_VM_DRAW_DEPLOYED" 1
	fps 35
}

$sequence "draw" {
	$macro_idlesequence
	activity "ACT_VM_DRAW" 1
	addlayer "delta_ik_draw"
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	frames 0 41
	fps 40
}

$sequence "draw_empty" {
	$macro_idlesequence
	activity "ACT_VM_DRAW_EMPTY" 1
	addlayer "delta_ik_draw"
	$macro_fire_boltback
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	frames 0 41
	fps 40
}

