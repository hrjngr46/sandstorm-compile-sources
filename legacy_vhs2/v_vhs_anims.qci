$sequence "fire" {
	$macro_idlesequence
	activity "ACT_VM_PRIMARYATTACK" 1
	snap
	addlayer "delta_ik_fire_1"
	$macro_fire_trigger
	$macro_fire_bolt
	frames 0 40
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	fps 40
}

