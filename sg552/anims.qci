$sequence "ready" {
	anims/AN_1P_SIG_B_Ready.smd
	activity "ACT_VM_DRAW_DEPLOYED" 1
	fps 30
}

$sequence "reload" {
	anims/AN_1P_SIG_B_Reload.smd
	activity "ACT_VM_RELOAD" 1
	fps 30
}

$sequence "reload_speed" {
	anims/AN_1P_SIG_B_Reload_Speed.smd
	activity "ACT_VM_RELOAD_SPEED" 1
	fps 30
}

$sequence "reload_empty" {
	anims/AN_1P_SIG_B_Reload_Empty.smd
