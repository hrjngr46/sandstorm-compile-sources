	"ValveBiped.Bip01_L_Finger01" 0
	"ValveBiped.Bip01_L_Finger0" 0
}

$weightlist "bolt" {
	"b_root" 0
	"b_wpn_slide" 1
}

$weightlist "trigger" {
	"b_root" 0
	"b_wpn_trigger" 1
	"b_ch_r_finger_10" 1
	"ValveBiped.Bip01_R_Finger1" 0
	"ValveBiped.Bip01_R_Finger11" 0
	"ValveBiped.Bip01_R_Finger12" 0
}

$weightlist "sprint" {
	"b_root" 1
	"b_wpn" 1
	"b_wpn_controller" 0
	"b_ch_r_hand" 0
	"b_ch_r_finger_11" 1
	"ValveBiped.Bip01_R_Finger1" 0
	"ValveBiped.Bip01_R_Finger11" 0
	"ValveBiped.Bip01_R_Finger12" 0
}

$weightlist "drawholster" {
	"b_root" 0
	"b_wpn" 1
	"b_camera" 1
	"b_wpn_controller" 0
	"b_ch_l_upperarm" 1
	"b_ch_r_finger_00" 1
	"ValveBiped.Bip01_R_Finger02" 0
