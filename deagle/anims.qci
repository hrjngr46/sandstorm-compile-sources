$definemacro macro_idlesequence \\
"anims\AN_1P_DEagle_B_Idle.smd" frames 1 1

$sequence "idle_macro" {
	$macro_idlesequence
	hidden
}

//IK fire

$animation ik_fire1 "anims\AN_1P_DEagle_B_Fire1.smd"
$sequence "delta_ik_fire1" delta ik_fire1 weightlist "weapon" hidden

$animation ik_fire2 "anims\AN_1P_DEagle_B_Fire2.smd"
$sequence "delta_ik_fire2" delta ik_fire2 weightlist "weapon" hidden

$animation ik_fire3 "anims\AN_1P_DEagle_B_Fire3.smd"
$sequence "delta_ik_fire3" delta ik_fire3 weightlist "weapon" hidden

//IK iron fire

$animation ik_iron_fire1 "anims\AN_1P_DEagle_B_Iron_Fire1.smd"
$sequence "delta_ik_iron_fire1" delta ik_iron_fire1 weightlist "weapon" hidden

$animation ik_iron_fire2 "anims\AN_1P_DEagle_B_Iron_Fire2.smd"
$sequence "delta_ik_iron_fire2" delta ik_iron_fire2 weightlist "weapon" hidden

$animation ik_iron_fire3 "anims\AN_1P_DEagle_B_Iron_Fire3.smd"
$sequence "delta_ik_iron_fire3" delta ik_iron_fire3 weightlist "weapon" hidden

//IK dryfire

$animation ik_dryfire "F:\tools\Sandstorm-Compile-Sources\generic\pistol\AN_1P_GEN_PIST_B_DryFire.smd"
$sequence "delta_ik_dryfire" delta ik_dryfire weightlist "weapon" hidden

//IK draw & holser

$animation ik_draw "F:\tools\Sandstorm-Compile-Sources\generic\pistol\AN_1P_GEN_PIST_B_Draw.smd"
$sequence "delta_ik_draw" predelta ik_draw weightlist "drawholster" hidden

$animation ik_holster "F:\tools\Sandstorm-Compile-Sources\generic\pistol\AN_1P_GEN_PIST_B_Holster.smd"
$sequence "delta_ik_holster" predelta ik_holster weightlist "drawholster" hidden

//IK fidget

$animation ik_fidget "F:\tools\Sandstorm-Compile-Sources\generic\pistol\AN_1P_GEN_PIST_B_Fidget.smd"
$sequence "delta_ik_fidget" delta ik_fidget weightlist "fidget" hidden

$animation ik_fidget_2 "F:\tools\Sandstorm-Compile-Sources\generic\pistol\AN_1P_GEN_PIST_B_Fidget2.smd"
$sequence "delta_ik_fidget_2" delta ik_fidget_2 weightlist "fidget" hidden

//IK sprint

$animation ik_sprint "F:\tools\Sandstorm-Compile-Sources\generic\pistol\AN_1P_GEN_PIST_M_Sprint.smd" subtract "idle_macro" 0
$sequence "delta_ik_sprint" delta ik_sprint weightlist "sprint" loop fixuploop -1 1 hidden

//IK lhand fix

$animation ik_lhand_fix "anims\AN_1P_DEagle_B_Idle.smd" subtract "idle_macro" 0
$sequence "delta_ik_lhand_fix" delta ik_lhand_fix frames 1 1 ikrule lhand touch "b_wpn" usesource

//IK breathing

$animation ik_breath "F:\tools\Sandstorm-Compile-Sources\generic\rifle\AN_1P_GEN_RIF_B_Breathing_01.smd"
$sequence "delta_ik_breath" delta ik_breath weightlist "weapon" hidden

//IK bash

$animation ik_bash "F:\tools\Sandstorm-Compile-Sources\generic\pistol\AN_1P_GEN_PIST_B_Melee.smd"
$sequence "delta_ik_bash" predelta ik_bash weightlist "drawholster" hidden

//Trigger & bolt macro

$sequence "delta_trigger" delta {
	F:\tools\Sandstorm-Compile-Sources\m9\anims\AN_1P_M9_B_Fire_Trigger.smd
	frames 0 10
	hidden
	weightlist "trigger"
}

$definemacro macro_trigger \\
blendlayer "delta_trigger" 0 1 10 10

$sequence "delta_bolt" delta {
	anims/AN_1P_DEagle_B_Idle_Empty.smd
	frames 1 1
	hidden
	weightlist "bolt"
}

$sequence "delta_boltback" delta {
	anims/AN_1P_DEagle_B_Idle_Empty.smd
	frames 1 1
	hidden
	weightlist "bolt"
}

$definemacro macro_bolt \\
blendlayer "delta_bolt" 0 1 2 4

$definemacro macro_boltback \\
addlayer "delta_boltback"

//Sequences

$sequence "draw" {
	$macro_idlesequence
	activity "ACT_VM_DRAW" 1
	addlayer "delta_ik_draw"
	blendlayer "delta_ik_lhand_fix" 18 20 34 34
	ikrule rhand touch "b_wpn" usesource
	frames 0 34
	fps 30
}

$sequence "draw_empty" {
	$macro_idlesequence
	$macro_boltback
	activity "ACT_VM_DRAW_EMPTY" 1
	addlayer "delta_ik_draw"
	blendlayer "delta_ik_lhand_fix" 18 20 34 34
	ikrule rhand touch "b_wpn" usesource
	frames 0 34
	fps 30
}

$sequence "holster" {
	$macro_idlesequence
	activity "ACT_VM_HOLSTER" 1
	addlayer "delta_ik_holster"
	ikrule rhand touch "b_wpn" usesource
	frames 0 19
	fps 30
}

$sequence "holster_empty" {
	$macro_idlesequence
	$macro_boltback
	activity "ACT_VM_HOLSTER_EMPTY" 1
	addlayer "delta_ik_holster"
	ikrule rhand touch "b_wpn" usesource
	frames 0 19
	fps 30
}

$sequence "idle" {
	$macro_idlesequence
	activity "ACT_VM_IDLE" 10
	addlayer "delta_ik_breath"
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	loop
	frames 0 160
	fps 30
}

$sequence "idle_empty" {
	$macro_idlesequence
	$macro_boltback
	activity "ACT_VM_IDLE_EMPTY" 10
	addlayer "delta_ik_breath"
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	loop
	frames 0 160
	fps 30
}

$sequence "sprint" {
	$macro_idlesequence
	activity "ACT_VM_SPRINT" 1
	addlayer "delta_ik_sprint"
	ikrule rhand touch "b_wpn" usesource
	loop
	frames 0 68
	fps 50
}

$sequence "sprint_empty" {
