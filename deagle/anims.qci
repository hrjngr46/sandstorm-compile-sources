$sequence "ready" {
	anims/AN_1P_DEagle_B_Ready.smd
	{ event 5004 3 "TFA_SR.PistolUnholster" }
	{ event 5004 54 "TFA_SR_DEAGLE.MagIn" }
	{ event 5004 58 "TFA_SR_DEAGLE.MagHit" }
	{ event 5004 94 "TFA_SR_DEAGLE.SlideBack" }
	{ event 5004 103 "TFA_SR_DEAGLE.SlideRelease" }
	activity "ACT_VM_DRAW_DEPLOYED" 1
	fps 30
}

$sequence "reload" {
	anims/AN_1P_DEagle_B_Reload.smd
	activity "ACT_VM_RELOAD" 1
	{ event 5004 18 "TFA_SR_DEAGLE.MagRelease" }
	{ event 5004 22 "TFA_SR_DEAGLE.MagOut" }
	{ event 5004 27 "TFA_SR_DEAGLE.MagOutArmMovement" }
	{ event 5004 83 "TFA_SR_DEAGLE.MagIn" }
	{ event 5004 88 "TFA_SR_DEAGLE.MagHit" }
	fps 30
}

