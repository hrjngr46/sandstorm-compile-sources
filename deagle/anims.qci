//b_wpn_controller is an extra bone for shorter weightlists, child of b_wpn
//valvebiped bones are not supposed to be in weightlists for deltas, so if they're fuckedup, set 0 for them

$weightlist "weapon" {
	"b_root" 0
	"b_camera" 1
	"b_wpn" 1
	"b_wpn_controller" 0
}

$weightlist "fidget" {
	"b_root" 0
	"b_camera" 1
	"b_wpn" 1
	"b_wpn_controller" 0
	"b_ch_r_finger_00" 1
	"b_ch_l_finger_00" 1
	"b_ch_l_finger_10" 1
	"b_ch_l_finger_20" 1
	"b_ch_l_finger_30" 1
	"b_ch_l_finger_40" 1
	"ValveBiped.Bip01_R_Finger02" 0
	"ValveBiped.Bip01_R_Finger01" 0
	"ValveBiped.Bip01_R_Finger0" 0
	"ValveBiped.Bip01_L_Finger12" 0
