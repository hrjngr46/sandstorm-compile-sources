//Idle macro

$definemacro macro_idlesequence \\
"anims\AN_1P_Welrod_B_Idle.smd"

$sequence "idle" {
	$macro_idlesequence
}

//IK fire layers

$animation a_ik_fire_1 "F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_fire.smd"
$sequence "delta_ik_fire_1" delta a_ik_fire_1 weightlist "weapon_only"

$animation a_ik_fire_2 "F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_fire_2.smd"
$sequence "delta_ik_fire_2" delta a_ik_fire_2 weightlist "weapon_only"

$animation a_ik_fire_3 "F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_fire_3.smd"
$sequence "delta_ik_fire_3" delta a_ik_fire_3 weightlist "weapon_only"

$animation a_ik_iron_1 "F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_iron_fire.smd"
$sequence "delta_ik_iron_1" delta a_ik_iron_1 weightlist "weapon_only"

$animation a_ik_iron_2 "F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_iron_fire2.smd"
$sequence "delta_ik_iron_2" delta a_ik_iron_2 weightlist "weapon_only"

$animation a_ik_iron_3 "F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_iron_fire3.smd"
$sequence "delta_ik_iron_3" delta a_ik_iron_3 weightlist "weapon_only"

//IK darw/holster

$sequence "delta_ik_draw" predelta {
	"F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_draw.smd"
	weightlist "draw_holster"
	hidden
}

$sequence "delta_ik_holster" predelta {
	"F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_holster.smd"
	weightlist "draw_holster"
	hidden
}

//IK melee

$sequence "delta_ik_melee" predelta {
	"F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_melee.smd"
	weightlist "melee"
	hidden
}

//IK sprint

$animation a_ik_sprint "F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_m_sprint.smd" subtract "idle" 0
$sequence "delta_ik_sprint" delta a_ik_sprint weightlist "sprint" loop fixuploop -1 1

//Inspect

$animation a_ik_inspect "F:\tools\sandstorm_source_files\release\animations\gen_pist\anims\an_1p_gen_pist_b_fidget.smd"
$sequence "delta_ik_inspect" delta a_ik_inspect weightlist "weapon_only"

//Trigger

$sequence "layer_trigger" {
	"anims\AN_1P_Welrod_B_Fire_Trigger.smd"
	weightlist "trigger"
}

$sequence "b_idle" {
	$macro_idlesequence
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	loop
	fps 30
}

$sequence "b_ready" {
	"anims\AN_1P_Welrod_B_Ready.smd"
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	fps 30
}

$sequence "b_reload" {
	"anims\AN_1P_Welrod_B_Reload_OPTIC.smd"
	ikrule rhand touch "b_wpn" usesource
	ikrule lhand touch "b_wpn" usesource
	fps 30
}

